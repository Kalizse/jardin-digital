
---
import LightDarkToggle from "./LightDarkToggle.astro";
---

<header class="sticky top-0 z-50 w-full">
  <div id="main-header" class="w-full bg-white dark:bg-[#222222]">
    <div class="w-full flex h-16 items-center justify-between px-4 sm:px-8 lg:px-12">

      <!-- Logo -->
      <a
        href="/"
        class="font-headings font-black text-3xl tracking-tight"
      >
        My Garden
      </a>

      <!-- Theme toggle -->
      <div class="flex items-center">
        <LightDarkToggle />
      </div>

    </div>
  </div>
</header>
