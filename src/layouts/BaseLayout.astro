
---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "@fontsource/merriweather";
import "@fontsource/lato";

const { title, description, pubDate, updatedDate, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <BaseHead
      title={title ? `${title} | ${SITE_TITLE}` : SITE_TITLE}
      description={description || SITE_DESCRIPTION}
      image={image}
    />
  </head>

  <body class="flex min-h-full bg-white text-slate-900 dark:bg-[#222222] dark:text-white">

    <!-- Background -->
    <div class="fixed inset-0 flex justify-center">
      <div class="w-[85vw] sm:w-[95vw] lg:w-[90vw] xl:w-[40vw] h-full bg-white dark:bg-[#222222]"></div>
    </div>

    <!-- Main layout -->
    <div class="relative flex w-full flex-col">
      <Header />

      <main class="flex-auto">
        <div class="mx-auto mt-8 w-[85vw] sm:w-[95vw] lg:w-[90vw] xl:w-[95vw]">
          <div class="relative w-full">
            <slot />
          </div>
        </div>
      </main>

      <Footer />
    </div>

  </body>
</html>
