
---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/articles/ArticleCard.astro";

const posts = (await getCollection("garden")).sort(
  (a: CollectionEntry<"garden">, b: CollectionEntry<"garden">) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Garden";

const description =
  "A collection of notes, ideas, discoveries and reflections.";

const imageRatios = [
  "aspect-[3/4]",
  "aspect-[4/3]",
  "aspect-square",
  "aspect-[5/4]",
  "aspect-[3/4]",
  "aspect-[16/9]",
];
---

<BaseLayout title={title} description={description}>
  <div class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2">
    <section>
      <div class="columns-2 lg:columns-3 2xl:columns-4 gap-x-4">
        {
          posts.map((post, index) => (
            <div class="break-inside-avoid mb-8">
              <ArticleCard
                post={post}
                imageRatio={imageRatios[index % imageRatios.length]}
              />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
