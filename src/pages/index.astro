---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImageDark from "../images/about-me-dark.jpg";
import heroImageLight from "../images/about-me-light.jpg";
import FeaturedArticles from "../components/articles/FeaturedArticles.astro";
import Projects from "../components/Projects.astro";
import { libros } from "../data/libros";
import NewsletterForm from "../components/NewsletterForm.astro";
---

<BaseLayout>
	<!-- Hero section -->
	<div class="mx-auto lg:max-w-4xl mt-40 mb-20">
		<div class="flex flex-col lg:flex-row lg:items-center lg:space-x-16">
			<div>
				<h1
					class="text-3xl sm:text-5xl font-bold tracking-tight text-balance"
				>
					Code. Blood. Mild workplace horror.
				</h1>
				<div class="mt-8 leading-8">
					<p>
						I’m Lorenzo di Lume Nero, a centuries-old vampire and
						full stack developer navigating startup life in
						Transylvania's tech scene. From nocturnal debugging tips
						to supernatural sprint planning, sink your fangs into
						articles that bite back.
					</p>
				</div>
			</div>

			<div class="order-first lg:order-last flex-shrink-0 mb-8">

				<Image
					src={heroImageLight}
					alt="Code. Blood. Mild workplace horror."
					class="block dark:hidden  rounded-full  size-20 lg:size-[350px] object-cover ring-1 ring-slate-400/30 shadow"
				/>
				<Image
					src={heroImageDark}
					alt="Code. Blood. Mild workplace horror."
					class="hidden dark:block rounded-full size-20 lg:size-[350px] object-cover ring-1 ring-slate-400/30 shadow"
				/>
			</div>
		</div>
	</div>

	<!-- Featured articles -->
	<div class="mx-auto lg:max-w-4xl my-16 sm:my-30">
		<h2
			class="text-2xl sm:text-4xl font-bold tracking-tight mb-10 sm:mb-20"
		>
			Featured articles
		</h2>
		<FeaturedArticles />
	</div>


	<!-- Library preview -->
	<section class="mx-auto lg:max-w-4xl my-16 sm:my-30">
		<div class="flex items-center justify-between gap-4 mb-6">
			<h2 class="text-2xl sm:text-4xl font-bold tracking-tight">
				Library
			</h2>

			<a
				href="/library"
				class="text-sm font-medium underline underline-offset-4"
			>
				View all →
			</a>
		</div>

		<p class="mb-8 text-slate-600 dark:text-slate-300">
			A small corner of my reading life.
		</p>

		<div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
			{libros.slice(0, 4).map((libro) => (
				<article>
					<a
						href={libro.goodreads}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`View ${libro.titulo} on Goodreads`}
						class="block"
					>
						<div class="aspect-[2/3] overflow-hidden rounded-md bg-slate-100 dark:bg-slate-800">
							<img
								src={libro.portada}
								alt={`Cover of ${libro.titulo}`}
								class="h-full w-full object-cover transition duration-200 hover:opacity-90"
								loading="lazy"
							/>
						</div>
					</a>

					<h3 class="mt-3 font-semibold">{libro.titulo}</h3>

					<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
						{libro.autor}
					</p>
				</article>
			))}
		</div>
	</section>


	<!-- Projects -->
	<!-- <div class="my-16 sm:my-30">
		<div class="mx-auto lg:max-w-4xl">
			<h2
				class="text-2xl sm:text-4xl font-bold tracking-tight mb-10 sm:mb-20"
			>
				Projects
			</h2>
		</div>

		<div class="mx-auto lg:max-w-5xl">
			<Projects />
		</div>
	</div>
	-->

	<!-- Newsletter -->
	<div class="mx-auto lg:max-w-4xl my-16 sm:my-30">
		<NewsletterForm />
	</div>
</BaseLayout>
