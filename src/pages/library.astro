
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { libros } from "../data/libros";
---

<BaseLayout title="Library">
  <main class="w-full">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-5 gap-y-10">
      {libros.map((libro) => (
        <article class="min-w-0">
          <a
            href={libro.goodreads}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver ${libro.titulo} en Goodreads`}
            class="block"
          >
            <div class="aspect-[2/3] overflow-hidden rounded-md bg-slate-100 dark:bg-slate-800">
              <img
                src={libro.portada}
                alt={`Portada de ${libro.titulo}`}
                class="h-full w-full object-cover transition duration-200 hover:opacity-90"
                loading="lazy"
              />
            </div>
          </a>

          <h2 class="mt-3 font-semibold">
            {libro.titulo}
          </h2>

          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            {libro.autor}
          </p>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
